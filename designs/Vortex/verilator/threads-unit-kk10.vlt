`verilator_config
// Vortex sane: two clusters, four GPU cores per cluster, eight workers.
// Required worker-to-CPU affinity: 0 1 2 3 4 5 6 7.
// Worker 0 is the calling/scheduler thread, pinned to physical CPU 0.
// GPU core index = 4*cluster + core within the cluster.
threads_group -module "VX_core" -workers 8->8: {
    0 1 2 3
    4 5 6 7
} -workers 8->1 -workers 8->2 -workers 8->4: {
    0 0 1 1
    2 2 3 3
}
