`verilator_config
// Caliptra default: 24 CPU, crypto, vault, and testbench units; automatic assignment.
// Nested ABR arithmetic units override the enclosing ABR unit.
threads_group -module "__rtlmeter_utils"
threads_group -module "abr_mem_top"
threads_group -module "abr_top"
threads_group -module "aes_clp_wrapper"
threads_group -module "caliptra_top"
threads_group -module "caliptra_top_tb_axi_complex"
threads_group -module "caliptra_top_tb_services"
threads_group -module "csrng"
threads_group -module "doe_ctrl"
threads_group -module "dv"
threads_group -module "ecc_top"
threads_group -module "el2_veer_wrapper"
threads_group -module "entropy_src"
threads_group -module "hmac_ctrl"
threads_group -module "kv"
threads_group -module "ntt_masked_gs_butterfly"
threads_group -module "ntt_masked_pwm"
threads_group -module "pv"
threads_group -module "sha256_ctrl"
threads_group -module "sha3_ctrl"
threads_group -module "sha512_ctrl"
threads_group -module "soc_ifc_top"
