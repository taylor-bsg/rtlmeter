`verilator_config
// OpenPiton 4x4 on eight workers; coordinates below are (y, x).
// Required worker-to-CPU affinity: 3 1 2 0 4 5 6 7.
// Worker 0 is the calling/scheduler thread, pinned to physical CPU 3.
// CPU owners by tile row: 0 1 2 3 / 0 1 2 3 / 4 5 6 7 / 4 5 6 7.
// Tile index = 4*y + x; entries below are logical worker indices.
threads_unit -module "tile" -workers 16->8: {
    3 1 2 0
    3 1 2 0
    4 5 6 7
    4 5 6 7
}
// Both chipset I/O crossbars run on physical CPU 0 (logical worker 3).
threads_unit -module "io_xbar_top_wrap" -workers 2->8: { 3 3 }
// Shared RISC-V peripherals run on physical CPU 1.
threads_unit -module "riscv_peripherals" -workers 1->8: { 1 }
// The PC monitor runs on physical CPU 4.
threads_unit -module "pc_cmp" -workers 1->8: { 4 }
